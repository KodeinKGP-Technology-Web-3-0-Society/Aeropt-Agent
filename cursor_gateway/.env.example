# Copy to .env (gitignored). Never commit real values.
CURSOR_API_KEY=
# Filled in automatically on first run; any secret of 16+ characters works.
GATEWAY_TOKEN=
# Default model for every request. Ids the SDK accepts today: grok-4.6, composer-2.5, auto, ...
CURSOR_MODEL=grok-4.6
# Optional: route specific agent model names to different Cursor models.
# CURSOR_MODEL_MAP={"openai/gpt-oss-120b":"composer-2.5"}
# MAX_CONCURRENCY=2
# REQUEST_TIMEOUT_MS=120000
# CURSOR_WARMUP=1
