# Supabase (User Data DB: users, sessions, chat_turns, progress)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-user-db-service-role-key
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=physics-diagrams

# Supabase (Retrieval DB: concepts, content, pgvector)
RETRIEVAL_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
RETRIEVAL_SUPABASE_URL=https://yyyy.supabase.co
RETRIEVAL_SUPABASE_KEY=your-retrieval-db-service-role-key

# LLM APIs
SARVAM_API_KEY=your-sarvam-api-key
GROQ_API_KEY=gsk_your-groq-key
GEMINI_API_KEY=your-gemini-key

# Django base for classroom evidence. Unset skips the post; the chat reply still returns.
DJANGO_API_BASE_URL=http://127.0.0.1:8000

# Paid voice routes are off until this is true. Speakers and health stay available.
# When enabled, transcribe and synthesize require the same learner token as chat.
VOICE_SPENDING_ENABLED=false
MAX_VOICE_BYTES=5242880

# ── Production (Hugging Face Space). Unset locally: auth is skipped without a key. ──
# AEROPT_ENV=production                 # refuses to start without the signing key / index
# DJANGO_JWT_SIGNING_KEY=               # equal to Django's SECRET_KEY; verifies student JWTs
# AGENT_SERVICE_TOKEN=                  # same value on Django; server-to-server calls
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# AEROPT_DURABLE_STATE=supabase         # copy ledger, carry and diagrams to Supabase
# AGENT_TURNS_PER_MINUTE=10
# AGENT_TURNS_PER_DAY=60
